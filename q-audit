#!/bin/sh
# launcher, use this instead of the installed entry point.
#
# this repo lives under ~/Desktop where macos keeps setting the UF_HIDDEN flag
# on everything inside .venv, and python's site.addpackage() silently skips
# hidden .pth files. so `uv pip install -e .` does nothing, the editable path
# never makes it onto sys.path and importing q_audit just fails with no
# explanation. running out of src/ avoids the whole thing. took me an
# embarrassingly long time to work that out, see the README.
here=$(cd "$(dirname "$0")" && pwd)
PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}" \
PYTHONWARNINGS="${PYTHONWARNINGS:-ignore}" \
exec "$here/.venv/bin/python" -m q_audit "$@"
